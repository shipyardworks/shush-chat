# shush-chat credentials -- copy to .env and fill in
#
# Gitignored, never committed. Credentials in git history are permanent and unretractable,
# even in a private repository.
#
# Every value here also has a default in the compose files, so a fresh clone still starts.
# These override those defaults on this machine.
#
# Do NOT quote values here, and do NOT `source` this file. It is read by docker compose AND by
# Spring, via spring.config.import in application.yml, which parses it as a .properties file --
# and there a quote is just another character. Single-quoting the values makes `./mvnw
# spring-boot:run` connect with a password that literally begins and ends with an apostrophe,
# which reads as a wrong password and nothing says otherwise.
#
# That is the opposite of platform/.env, which shell scripts really do source and which
# therefore really does need the quotes. Same filename, two consumers, two rules.
#
# For anything real these do NOT belong in a file on disk: a .env on a production host sits in
# backups, in `docker inspect` output and in any process listing. Use a secret manager there.
#
# 10 values below are SHARED with platform/.env and must match. If chat stops
# authenticating after you rotate one, this is why.


# --- shared datastores (issued by platform) ------------------------------
SHUSH_DB_NAME=   # shared
SHUSH_DB_USER=   # shared
SHUSH_DB_PASSWORD=   # shared
SHUSH_REDIS_PASSWORD=   # shared
SHUSH_KAFKA_USER=   # shared
SHUSH_KAFKA_PASSWORD=   # shared
SHUSH_ES_USER=   # shared
SHUSH_ES_PASSWORD=   # shared
SHUSH_S3_ACCESS_KEY=   # shared
SHUSH_S3_SECRET_KEY=   # shared

# --- ports and addresses ---------------------------------------------------------
# Every one of these has a default in compose, so nothing breaks if you delete them. They are
# written out because a default buried three files away is not documentation, and because the
# ones marked (browser) are the addresses a person's browser must reach -- change them and the
# app must be rebuilt, not just restarted, since they are baked into signed URLs.
#
# HTTP_PORT is owned by platform (the shared nginx publishes it). It is repeated here
# only so SHUSH_S3_PUBLIC_ENDPOINT below can be read without opening the other repo.

# (browser) where the app is served -- platform/edge publishes this
SHUSH_HTTP_PORT=8081

# (browser) the address the browser uses for image bytes, in both directions. Not
# http://minio:9000: a presigned URL is signed for its host, so it has to name the address the
# browser will actually reach.
#
# The app's own origin, not MinIO's host port -- nginx carries /shush-media/ through to MinIO
# (platform/edge/nginx/conf.d/shush.conf). Naming MinIO directly works on a laptop and nowhere
# else: on a real domain that port is loopback-only, and plain http under an https page is
# blocked regardless. Pointing it here means the path under test locally is the deployed one.
SHUSH_S3_PUBLIC_ENDPOINT=http://localhost:8081

# Internal, container-to-container. The app talks to these over the shared data network; they
# are not reachable from a browser and are not meant to be.
SHUSH_DB_HOST=postgres
SHUSH_DB_PORT=5432
SHUSH_REDIS_HOST=redis-shush
SHUSH_REDIS_PORT=6379
SHUSH_KAFKA_BOOTSTRAP=redpanda:9092
SHUSH_ELASTICSEARCH_URIS=http://elasticsearch:9200
SHUSH_S3_ENDPOINT=http://minio:9000

# --- application only ------------------------------------------------------------
SHUSH_JWT_SECRET=
SHUSH_DEV_ENDPOINTS=

# How long a shared image lives, by whether anyone in the conversation has an account.
# Both default to 30d. pre-plan.md 5 point 4 sets the anonymous tier at 24h against a real
# storage bill -- set these back to 24h/30d when there is one. Changing them governs the next
# upload only: the deadline is written onto the row when the image is created.
# Left commented, not blank: `./mvnw spring-boot:run` reads this file as .properties, where a
# blank value is an empty string rather than "unset" -- and an empty string is not a Duration.
# That is bug 15 again, in a new place.
#SHUSH_MEDIA_RETENTION_ANONYMOUS=24h
#SHUSH_MEDIA_RETENTION_SAVED=30d
